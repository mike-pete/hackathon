# Everything is optional: the app auto-detects a local model and falls back
# to a deterministic mock, and JevRouter runs offline via its demo provider.

# --- LLM -------------------------------------------------------------------
# Auto-detected from LM Studio at http://127.0.0.1:1234/v1.
# Override only if you want a specific host/model.
# LLM_BASE_URL=http://127.0.0.1:1234/v1
# LLM_MODEL=qwen3-30b-a3b-abliterated
# LLM_API_KEY=lmstudio

# OpenCode Zen gateway is tried if LM Studio is unavailable.
# OPENCODE_API_KEY=...
# OPENCODE_MODEL=gpt-5.5

# --- JEV -------------------------------------------------------------------
# Run `npm run jev` to serve JevRouter on 8787 for a faster route (HTTP path).
# Without it the app shells out to the JevRouter CLI with the offline demo
# provider. Set JEV_PROVIDER=openrouter + OPENROUTER_API_KEY for live Jev.
# JEV_HTTP_URL=http://127.0.0.1:8787
# JEV_PROVIDER=demo

# --- Research (optional) ---------------------------------------------------
# EXA_API_KEY=...
